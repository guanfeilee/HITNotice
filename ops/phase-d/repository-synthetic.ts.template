// Copy to the root of the verified Phase B archive before executing with tsx.
import assert from 'node:assert/strict';
import {readFileSync,writeFileSync} from 'node:fs';
import {query,closePool} from './lib/db/pool';
import {transaction} from './lib/db/transaction';
import {saveSubscription,subscriptionSources,unsubscribeByToken} from './lib/db/subscriptions';
import {upsertNoticeBatch} from './lib/db/notices';
import {claimDigestDelivery,recordDigestDeliveryAccepted,recordDigestDeliveryFailure,getDigestDeliveryById} from './lib/db/deliveries';
import {claimScheduledDigestRun} from './lib/db/digest-runs';
import {serializeRequestError} from './lib/email/error-details';
let networkAttempts=0;globalThis.fetch=async()=>{networkAttempts++;throw Error('NETWORK_FORBIDDEN');};
const dir=readFileSync('/root/hitnotice-phase-d-20260905/current-artifact-path','utf8').trim();
const result:any={status:'IN_PROGRESS',database:'hitnotice_phased_synthetic',checks:{}};let phase='setup';
async function main(){
 const c=JSON.parse(readFileSync('/etc/hitnotice/postgresql-runtime.json','utf8'));assert.equal(c.host,'127.0.0.1');
 const url=new URL('postgresql://127.0.0.1:5432/hitnotice_phased_synthetic');url.username=c.user;url.password=c.password;process.env.DATABASE_URL=url.toString();
 for(const key of Object.keys(process.env))if(/RESEND|SUPABASE|WECHAT/.test(key))delete process.env[key];
 assert.equal((await query('SELECT current_database() AS db')).rows[0].db,'hitnotice_phased_synthetic');
 for(const table of ['notices','subscriptions','email_deliveries','digest_runs'])assert.equal(Number((await query(`SELECT count(*) AS n FROM ${table}`)).rows[0].n),0);
 phase='subscribe';const sub=await saveSubscription('phase-d-test@example.invalid','weekday_digest',['fixture-a']);
 await saveSubscription('phase-d-test@example.invalid','weekday_digest',['fixture-b','fixture-c']);
 await assert.rejects(saveSubscription('phase-d-test@example.invalid','weekly_digest',[' ']));
 assert.deepEqual((await subscriptionSources(sub.id)).map(r=>r.source_id).sort(),['fixture-b','fixture-c']);
 assert.equal((await query('SELECT frequency FROM subscriptions WHERE id=$1',[sub.id])).rows[0].frequency,'weekday_digest');
 const concurrent=await Promise.all(Array.from({length:8},(_,i)=>saveSubscription('phase-d-concurrent@example.invalid','weekday_digest',['fixture-'+i])));
 assert.equal(new Set(concurrent.map(s=>s.id)).size,1);assert.equal((await subscriptionSources(concurrent[0].id)).length,1);
 await assert.rejects(transaction('synthetic_rollback',async client=>{await client.query("INSERT INTO subscriptions(email,frequency) VALUES('phase-d-rollback@example.invalid','weekday_digest')");throw Error('EXPECTED_ROLLBACK');}));
 assert.equal(Number((await query("SELECT count(*) AS n FROM subscriptions WHERE email='phase-d-rollback@example.invalid'")).rows[0].n),0);
 result.checks.subscriptions={create:true,replace:true,failureRollback:true,explicitRollback:true,concurrentRequests:8,singleIdentity:true};
 phase='crawler';const fixture={title:'Phase D synthetic',url:'https://example.invalid/phase-d',source_id:'fixture-a',source_name:'Fixture',category:'test',published_at:null,first_seen_at:'2030-01-01T00:00:00.123456Z',hash:'phase-d-synthetic-notice'};
 assert.deepEqual(await upsertNoticeBatch([fixture]),{inserted:1,updated:0,unchanged:0});
 assert.deepEqual(await upsertNoticeBatch([{...fixture,title:'Changed synthetic',first_seen_at:'2030-01-02T00:00:00Z'}]),{inserted:0,updated:1,unchanged:0});
 assert.deepEqual(await upsertNoticeBatch([{...fixture,title:'Changed synthetic'}]),{inserted:0,updated:0,unchanged:1});
 assert.equal((await query('SELECT first_seen_at FROM notices WHERE hash=$1',[fixture.hash])).rows[0].first_seen_at,'2030-01-01T00:00:00.123456Z');
 result.checks.crawler={insert:true,update:true,unchanged:true,firstSeenMicrosecondsPreserved:true};
 phase='delivery_claims';const window={start:new Date('2030-01-01T00:00:00Z'),end:new Date('2030-01-02T00:00:00Z')};
 const p={subscriptionId:sub.id,digestType:'weekday_digest' as const,window,noticeCount:1};
 const claims=await Promise.all(Array.from({length:10},()=>claimDigestDelivery(p)));assert.equal(claims.filter(c=>c.claimed).length,1);
 const id=claims[0].delivery.id;assert.equal(new Set(claims.map(c=>c.delivery.id)).size,1);
 await recordDigestDeliveryFailure({deliveryId:id,attempt:1,durationMs:1,httpStatus:null,errorMessage:'Synthetic failure',errorDetails:serializeRequestError(new Error('Synthetic'),{stage:'phase-d'}),responseSummary:null});
 const retry=await claimDigestDelivery(p);assert.equal(retry.claimed,true);assert.equal(retry.reason,'retry_claimed');
 await recordDigestDeliveryAccepted({deliveryId:id,resendEmailId:'phase-d-synthetic-provider',attempt:2,durationMs:1,httpStatus:200,responseSummary:'synthetic'});
 await recordDigestDeliveryFailure({deliveryId:id,attempt:2,durationMs:1,httpStatus:null,errorMessage:'Synthetic late failure',errorDetails:serializeRequestError(new Error('Synthetic'),{stage:'phase-d'}),responseSummary:null});
 assert.equal((await getDigestDeliveryById(id))?.status,'accepted');assert.equal((await claimDigestDelivery(p)).claimed,false);
 result.checks.deliveryClaims={concurrentRequests:10,singleClaim:true,failedRetry:true,acceptedProtection:true};
 phase='run_claims';const runs=await Promise.all(Array.from({length:10},()=>claimScheduledDigestRun({digestType:'weekday_digest',window})));assert.equal(runs.filter(r=>r.claimed).length,1);assert.equal(new Set(runs.map(r=>r.run.id)).size,1);result.checks.runClaims={concurrentRequests:10,singleClaim:true};
 phase='unsubscribe';const unsub=await Promise.all(Array.from({length:5},()=>unsubscribeByToken(sub.unsubscribe_token)));assert.equal(unsub[0]?.status,'unsubscribed');for(const r of unsub)assert.deepEqual(r,unsub[0]);result.checks.unsubscribe={concurrentRequests:5,idempotent:true};
 assert.equal(networkAttempts,0);result.networkAttempts=0;result.status='PASS';writeFileSync(dir+'/synthetic-results.json',JSON.stringify(result,null,2)+'\n',{mode:0o600});console.log(JSON.stringify(result));
}
main().catch(()=>{result.status='FAIL';result.failedPhase=phase;writeFileSync(dir+'/synthetic-results.json',JSON.stringify(result,null,2)+'\n',{mode:0o600});console.log(JSON.stringify({status:'FAIL',failedPhase:phase}));process.exitCode=1;}).finally(closePool);
