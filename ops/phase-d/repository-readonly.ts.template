}
main().catch(()=>{result.status='FAIL';result.failedPhase=phase;writeFileSync(output,JSON.stringify(result,null,2)+'\n',{mode:0o600});console.log(JSON.stringify({status:'FAIL',failedPhase:phase}));process.exitCode=1;}).finally(closePool);
