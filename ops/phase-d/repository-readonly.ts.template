 }
 result.checks.scheduledRunReads=all.digest_runs.length;
 phase='admin';let adminFilters=0;
 for(const filter of [null,'invalid-source',...sourceRegistry.filter(s=>s.enabled).map(s=>s.name)]){
  const got=await getAdminNotices(filter);assert.ok(got.notices.length<=200);
  const raw=(await query('SELECT title,url,source_name FROM notices WHERE ($1::text=\'\' OR source_name=$1) ORDER BY first_seen_at DESC LIMIT 200',[got.selectedSource])).rows;
  assert.deepEqual(got.notices,raw);for(const row of got.notices)assert.deepEqual(Object.keys(row).sort(),['source_name','title','url']);adminFilters++;
 }
 result.checks.admin={filters:adminFilters,limit:200,shapeAndFilterAndOrder:'PASS'};
 phase='health';
 const recent=(await query('SELECT * FROM crawl_runs ORDER BY started_at DESC LIMIT 500')).rows;
 const expectedCrawler=crawlSources.map(s=>{const latest:any=recent.find((r:any)=>r.source_id===s.id),success:any=recent.find((r:any)=>r.source_id===s.id&&r.status==='success');return latest?{sourceId:s.id,sourceName:latest.source_name||s.name,status:latest.status==='success'?'OK':'FAIL',foundCount:latest.found_count,newCount:latest.new_count,httpStatus:latest.http_status,errorMessage:latest.error_message,startedAt:latest.started_at,finishedAt:latest.finished_at,lastSuccessAt:success?.finished_at??null}:{sourceId:s.id,sourceName:s.name,status:'NO_DATA',foundCount:0,newCount:0,httpStatus:null,errorMessage:'No crawl run recorded',startedAt:null,finishedAt:null,lastSuccessAt:null};});
 assert.deepEqual(await getCrawlerHealth(),expectedCrawler);
 const scenarios=[now,new Date(Math.max(...all.digest_runs.map((r:any)=>time(r.period_end)))+30*60000)];
 result.health=[];
 for(const moment of scenarios){
  const start=moment.getTime()-86400000,counts=new Map<string,number>();
  for(const row of all.notices)if(time(row.first_seen_at)>=start&&time(row.first_seen_at)<moment.getTime())counts.set(row.source_id,(counts.get(row.source_id)??0)+1);
  assert.deepEqual(await noticeCounts({start:new Date(start),end:moment}),counts);
  const digests:any={};
  for(const type of types){const schedule=getDigestSchedule(type,moment);const run=schedule.window?await getScheduledDigestRun(type,schedule.window):null;const rows=run?all.email_deliveries.filter((d:any)=>d.digest_type===type&&time(d.period_end)===schedule.window!.end.getTime()):[];digests[type]=buildDigestHealthStatus({digestType:type,now:moment,schedule,run,deliveries:rows,webhookTracking:false});}
  const report=await generateHealthReport(moment),expected=buildHealthReport({now:moment,crawlerHealth:expectedCrawler as any,noticeCounts:counts,digests});assert.deepEqual(report,expected);
  const metrics=calculateDeliveryHealthMetrics(all.email_deliveries,moment);assert.equal(metrics.accepted,all.email_deliveries.filter((d:any)=>accepted.has(d.status)||d.accepted_at||d.sent_at).length);
  result.health.push({at:moment.toISOString(),overall:report.overallStatus,totalSources:report.totalSources,successful:report.successfulSources,failed:report.failedSources,stale:report.staleSources,noData:report.noDataSources,newNotices:report.totalNewNotices,digestStates:Object.fromEntries(types.map(t=>[t,report.digests[t].status])),allDeliveryMetrics:metrics});
 }
 result.checks.health='Snapshot-derived counts/crawler state and unchanged pure health business rules agree; generate only';
 phase='performance';
 const sample=all.subscriptions.find((s:any)=>s.status==='active'),ids=all.subscription_sources.filter((s:any)=>s.subscription_id===sample.id).map((s:any)=>s.source_id),window=getDefaultDigestWindow('weekday_digest',end);
 const bench:any={activeSubscriptions:()=>digest.getActiveDigestSubscriptions('weekday_digest'),subscriptionSources:()=>digest.getSubscriptionSources(sample.id),digestNotices:()=>digest.getNoticesForSources(ids,window),healthAggregates:()=>generateHealthReport(now),adminNotices:()=>getAdminNotices(null),latestDelivery:()=>digest.getLatestPermanentDeliveryBlock(sample.id),latestRun:()=>getScheduledDigestRun('weekday_digest',window)};
 for(const [name,fn] of Object.entries(bench)){await (fn as any)();const samples=[];for(let i=0;i<20;i++){const t=performance.now();await (fn as any)();samples.push(performance.now()-t);}samples.sort((a,b)=>a-b);result.performance[name]={samples:20,medianMs:+((samples[9]+samples[10])/2).toFixed(3),maxMs:+samples[19].toFixed(3)};}
 assert.equal(networkAttempts,0);result.networkAttempts=0;result.poolMax=getPool().options.max;result.status='PASS';
