const time=(s:string)=>new Date(s).getTime();
async function main(){
 const c=JSON.parse(readFileSync('/etc/hitnotice/postgresql-runtime.json','utf8'));
 assert.equal(c.host,'127.0.0.1');c.database='hitnotice_migration_rehearsal';
 const url=new URL('postgresql://127.0.0.1:5432/hitnotice_migration_rehearsal');url.username=c.user;url.password=c.password;
 process.env.DATABASE_URL=url.toString();
