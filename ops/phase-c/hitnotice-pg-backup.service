[Unit]
Description=HITnotice PostgreSQL local backup (no application jobs)
After=postgresql@17-main.service
Requires=postgresql@17-main.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/hitnotice-pg-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min
PrivateTmp=true
