# Web host (EdgeOne or another Next.js Node.js host). Values intentionally blank.
# Missing API configuration is allowed during build and fails closed at runtime.
HITNOTICE_ECS_API_BASE_URL=
HITNOTICE_INTERNAL_API_SECRET=
ADMIN_CHECK_TOKEN=
NEXT_PUBLIC_SITE_URL=

# ECS ONLY. Never provision these secrets on the web host.
DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
HEALTH_REPORT_EMAIL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
HITNOTICE_ECS_API_PORT=
HITNOTICE_RELEASE_COMMIT=
# ECS writer control: absent/unknown is maintenance. Opening requires a separate cutover.
HITNOTICE_WRITE_MODE=

# Optional, read-only ECS/PoC check. Use a preview backend for platform testing.
HITNOTICE_ECS_API_CHECK_BASE_URL=
HITNOTICE_ECS_API_CHECK_ADMIN=

# Supabase credentials and RESEND_WEBHOOK_SECRET are not used by canonical runtimes.
